<div class="col-lg-12">
  <div class="card rounded-0 mb-5 mt-5">
    <div class="card-body">
      <h2 class="text-center">Document Information</h2>
        <div class="row text-center">
            <div>
                <% if @document.image.attached? %>
                  <%= image_tag @document.image%>
                <% end %>
            <div>
            <p class="lead">
              <strong>Document Name : </strong><%= @document.doc_name%>
            </p>  
            <p class="lead">
              <strong>Document Type : </strong><%= @document.doc_type%>
            </p> 
         
            <p class="lead">
              <strong>Employee Name : </strong><%= @document.employee.name%>
            </p>            
      </div>
      <%= link_to "Edit", edit_document_path(@document), class:"btn btn-secondary rounded-0" %>
      <%= link_to "View Employee", employee_path(@document.employee), class:"btn btn-success rounded-0" %>
      <%= link_to "Back to Documents", documents_path, class:"btn btn-danger rounded-0" %>
    </div>
  </div>
</div>