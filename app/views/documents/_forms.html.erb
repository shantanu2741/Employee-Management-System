<%= form_with model: @document do |form| %>
    <div class="row">
        <div class="col-lg-4">
            <div class="form-group">
                <%= form.label :doc_name, class:"mb-2" %>
                <%= form.text_field :doc_name, class:"form-control form-control-lg rounded-0" %>
                    <% @document.errors.full_messages_for(:doc_name).each do |error|%>
                        <p><%= error%></p>
                    <% end %>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="form-group">
                <%= form.label :doc_type, class:"mb-2" %>
                <%= form.text_field :doc_type, class:"form-control form-control-lg rounded-0" %>
                    <% @document.errors.full_messages_for(:doc_type).each do |error|%>
                        <p><%= error%></p>
                    <% end %>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="form-group">
                <%= form.label :employee_id, class:"mb-2" %>
                <%= form.number_field :employee_id, class:"form-control form-control-lg rounded-0" %>
                    <% @document.errors.full_messages_for(:employee_id).each do |error|%>
                        <p><%= error%></p>
                    <% end %>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="form-group">
                <%= form.label :image, class:"mb-2" %>
                <%= form.file_field :image, class:"form-control form-control-lg rounded-0" %>
                    <% @document.errors.full_messages_for(:image).each do |error|%>
                        <p><%= error%></p>
                    <% end %>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12 mt-4">
            <%= form.submit class:"btn btn-lg btn-primary rounded-0" %>
            <%= link_to "Back to Documents", documents_path, class:"btn btn-outline-primary btn-lg rounded-0 " %>
        </div>
    </div>
<% end %>